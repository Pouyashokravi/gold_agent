OPENAI_API_KEY=sk-your-openai-key-here
TWELVE_DATA_API_KEY=your-twelve-data-key-here
FRED_API_KEY=your-fred-api-key-here
TAVILY_API_KEY=tvly-your-tavily-key-here
DATABASE_URL=sqlite:///./gold_agent.db

# Model strategy (environment-configurable)
FAST_MODEL=gpt-5.4-nano
MANAGER_MODEL=gpt-5.4
NEWS_MODEL=gpt-5.4-mini
FUNDAMENTAL_MODEL=gpt-5.4-mini
TECHNICAL_MODEL=gpt-5.4-mini
MAX_REPLAN_ROUNDS=2

# Optional Conversation Gate / Summarizer overrides (default → FAST_MODEL)
CONVERSATION_GATE_MODEL=
CONVERSATION_SUMMARY_MODEL=
RECENT_MESSAGES_LIMIT=20
MAX_CLARIFICATION_TURNS=3

# Optional shared specialist fallback when NEWS/FUNDAMENTAL/TECHNICAL are unset
SPECIALIST_MODEL=gpt-5.4-mini

# Legacy aliases (optional — still accepted)
QUERY_MODEL=
PLANNER_MODEL=
SYNTHESIS_MODEL=
ANSWER_MODEL=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
TAVILY_ENABLED=true
TAVILY_MONTHLY_BUDGET=900
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=8
MOCK_EXTERNAL_APIS=false
